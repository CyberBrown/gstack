#!/usr/bin/env bash
# gstack-outside-prompt: private prompt files for /autoplan's outside voices
# (Codex and Hermes). Sourced from template bash blocks; never execute directly.
#
# Why: outside-voice prompts carry model-written text (plan paths, CEO/Design/
# Eng summaries). Pasting that text inside a double-quoted shell argument lets
# backticks and $(...) in it execute in the user's shell. Instead, the skill
# writes the prompt to a private file with the Write tool and the shell only
# ever sees "$(cat <file>)"-style expansion of a variable, never the text as
# shell source.
#
# Functions (all prefixed with _gstack_outside_prompt_):
#   _gstack_outside_prompt_new      — create a 0700 mktemp dir, print
#                                     "OUTSIDE_PROMPT_FILE: <dir>/prompt"
#   _gstack_outside_prompt_read     — validate a path from _new and print the
#                                     file's contents (exit 1 on anything else)
#   _gstack_outside_prompt_cleanup  — remove the private dir created by _new
#   _gstack_outside_trust_check     — repo trust gate: is this repo allowed to
#                                     send code/plans to an outside voice?
#
# Hygiene rules (enforced by test/outside-prompt.test.ts):
#   - Never set -e / set -u / trap / IFS= / PATH= in this file.
#   - No command execution at source time (only function defs).

_gstack_outside_prompt_base() {
  # The directory _new creates its private dirs under. Strip a trailing
  # slash so the path pattern in _read matches what mktemp produced.
  local _b="${TMPDIR:-/tmp}"
  printf '%s' "${_b%/}"
}

_gstack_outside_prompt_new() {
  local _base _dir
  _base=$(_gstack_outside_prompt_base)
  _dir=$(mktemp -d "$_base/gstack-outside.XXXXXXXX") || return 1
  chmod 700 "$_dir" 2>/dev/null || { rm -rf "$_dir"; return 1; }
  : > "$_dir/prompt" || { rm -rf "$_dir"; return 1; }
  chmod 600 "$_dir/prompt" 2>/dev/null || true
  echo "OUTSIDE_PROMPT_FILE: $_dir/prompt"
}

_gstack_outside_prompt_valid() {
  # A path is accepted only if it has the exact shape _new produces:
  # <base>/gstack-outside.<8 alnum>/prompt, is a regular non-symlink file
  # owned by the caller, and its directory is not a symlink.
  local _f="$1" _base _dir _name
  _base=$(_gstack_outside_prompt_base)
  case "$_f" in
    "$_base"/gstack-outside.*/prompt) ;;
    *) return 1 ;;
  esac
  _dir="${_f%/prompt}"
  _name="${_dir#"$_base"/gstack-outside.}"
  [[ "$_name" =~ ^[A-Za-z0-9]{8}$ ]] || return 1
  [ -d "$_dir" ] && [ ! -L "$_dir" ] && [ -O "$_dir" ] || return 1
  [ -f "$_f" ] && [ ! -L "$_f" ] && [ -O "$_f" ] || return 1
  return 0
}

_gstack_outside_prompt_read() {
  # Print the prompt file's contents. Refuses unknown paths and empty files
  # (an empty file means the Write step was skipped).
  local _f="$1"
  if ! _gstack_outside_prompt_valid "$_f"; then
    echo "ERROR: outside-voice prompt file is not one created by _gstack_outside_prompt_new: $_f" >&2
    return 1
  fi
  if [ ! -s "$_f" ]; then
    echo "ERROR: outside-voice prompt file is empty; write the prompt to it with the Write tool first" >&2
    return 1
  fi
  cat -- "$_f"
}

_gstack_outside_prompt_cleanup() {
  local _f="$1"
  _gstack_outside_prompt_valid "$_f" || return 0
  rm -rf -- "${_f%/prompt}"
}

_gstack_outside_trust_check() {
  # Usage: _gstack_outside_trust_check <repo_root> <deny_list>
  # deny_list = colon-separated path globs (gstack-config key
  # outside_voice_trust_deny), e.g. "~/projects/52L/*:~/clients/*". A leading
  # "~/" means $HOME. A repo whose root equals a pattern or sits under it is
  # denied. Prints TRUST_OK, or TRUST_DENIED:<pattern> and returns 1.
  # An empty list allows everything (the decision of what to deny is the
  # user's; there is no built-in deny list).
  local _root="$1" _list="$2" _p _pat _real
  [ -n "$_root" ] || { echo "TRUST_OK"; return 0; }
  _root="${_root%/}"
  # Check both the path as given and its symlink-free form.
  _real=$(cd "$_root" 2>/dev/null && pwd -P) || _real="$_root"
  local _rest="$_list"
  while [ -n "$_rest" ]; do
    _p="${_rest%%:*}"
    if [ "$_p" = "$_rest" ]; then _rest=""; else _rest="${_rest#*:}"; fi
    [ -n "$_p" ] || continue
    case "$_p" in
      "~/"*) _pat="$HOME/${_p#\~/}" ;;
      "~") _pat="$HOME" ;;
      *) _pat="$_p" ;;
    esac
    _pat="${_pat%/}"
    # Unquoted $_pat on purpose: it is a glob pattern.
    # shellcheck disable=SC2254
    case "$_root" in
      $_pat|$_pat/*) echo "TRUST_DENIED:$_p"; return 1 ;;
    esac
    # shellcheck disable=SC2254
    case "$_real" in
      $_pat|$_pat/*) echo "TRUST_DENIED:$_p"; return 1 ;;
    esac
  done
  echo "TRUST_OK"
  return 0
}
